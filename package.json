{
  "name": "apagalo",
  "version": "1.2.0",
  "private": true,
  "description": "¡Apágalo!: juego de bomberos en 3D low-poly para web, CrazyGames y Android",
  "homepage": "https://apagalo.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nocodeboy/apagalo.git"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:dev": "node build.mjs --dev",
    "typecheck": "tsc --noEmit -p .",
    "serve": "python3 -m http.server 8765 --bind 127.0.0.1 -d dist",
    "bot": "tsx tools/bot.ts 10",
    "daily-table": "tsx tools/daily-table.ts",
    "android:sync": "node build.mjs && cap sync android",
    "deploy:web": "node build.mjs && cd dist/web && npx vercel@latest deploy --prod"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/share": "^8.0.2",
    "@capgo/native-purchases": "^8.8.1",
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/bungee": "^5.3.0",
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
